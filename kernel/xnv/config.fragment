# XNV baseline Linux kernel configuration fragment
# Linux remains the sole kernel; these options provide the XNV isolation,
# compatibility and message-passing primitives.
CONFIG_LOCALVERSION="-mintosh-xnv"

# Linux namespaces and resource controls.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# Mach-inspired task, port, event and memory-object primitives on Linux.
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y

# Filesystem observation and descriptor-based service APIs.
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# Process isolation and security auditing.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_KEYS=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Linux networking and extensible kernel policy.
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
